# ──────────────────────────────────────────────────────────────────────────
#  Configuración del SaaS de facturación
#
#  Puesta en marcha en local:
#    cp .env.example .env.local
#    openssl rand -base64 32        → pégalo en SESSION_SECRET
#    docker compose up -d
#    npm run seed && npm run dev
#
#  Los valores de este fichero ya coinciden con docker-compose.yml, así que
#  solo SESSION_SECRET necesita que pongas algo tuyo.
# ──────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=saas_facturacion

# ── Almacenamiento S3 (RustFS en local) ───────────────────────────────────
# La aplicación crea el bucket la primera vez que sube un adjunto.
AWS_USERNAME=rustfsadmin
AWS_PASSWORD=rustfsadmin
AWS_REGION=us-east-1
AWS_URL=http://localhost:9001
AWS_BUCKET=facturacion
# RustFS y MinIO solo entienden path-style. Déjalo en true salvo que uses AWS S3.
AWS_FORCE_PATH_STYLE=true

# ── Correo (MailHog en local) ─────────────────────────────────────────────
# mailhog → SMTP sin TLS contra el contenedor. resend → API de Resend.
EMAIL_PROVIDER=mailhog
EMAIL_FROM=Talonario <facturas@localhost>
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# ── Sesión y enlaces de acceso ────────────────────────────────────────────
# URL pública de la app: se usa para construir el enlace del correo.
APP_URL=http://localhost:3000
# Firma la cookie de sesión. Genera el tuyo: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Minutos que vive el enlace mágico antes de caducar.
MAGIC_LINK_TTL_MINUTOS=15
# Días que dura la sesión iniciada.
SESSION_TTL_DIAS=7

# ── Datos de demostración (seed) y pruebas E2E ────────────────────────────
# Cuenta que crea `npm run seed` y con la que entran las pruebas de Playwright.
DEMO_EMAIL=demo@talonario.test
# API HTTP de MailHog: de ahí leen los tests el enlace mágico.
MAILHOG_API_URL=http://localhost:8025
# URL contra la que corre Playwright.
E2E_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
#  PRODUCCIÓN — referencia, no activar aquí
#
#  Mismas variables, distintos valores: el código no cambia, solo el entorno.
#  Estas se cargan en Vercel (entorno Production), nunca en el repositorio.
# ──────────────────────────────────────────────────────────────────────────
#
# Base de datos — MongoDB Atlas
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=saas_facturacion
#
# Almacenamiento — Cloudflare R2 (mismo SDK que RustFS)
# AWS_USERNAME=<access key id de R2>
# AWS_PASSWORD=<secret access key de R2>
# AWS_REGION=auto
# AWS_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_BUCKET=facturacion
# AWS_FORCE_PATH_STYLE=true
#
# Correo — Resend sobre el dominio mail.jpavon-tech.com
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Talonario <facturas@mail.jpavon-tech.com>
# RESEND_API_KEY=<api key de Resend>
#
# Aplicación
# APP_URL=https://facturacion.jpavon-tech.com
# SESSION_SECRET=<secreto generado, distinto del de local>
